+        micromamba-version: latest
+        create-args: >-
+          python=3.12
+          anaconda-client
+          conda-build
+        post-cleanup: 'none'
     - name: Build and publish on Anaconda
       env:
         ANACONDA_API_TOKEN: ${{ secrets.ANACONDA_API_TOKEN }}
       run: |
         conda build conda-recipe/. -c conda-forge --croot ~/conda-bld
