+
+  # A job of its own: if it fails, "Re-run failed jobs" repeats only this part. The deploy job cannot
+  # be repeated for a version PyPI already has.
+  conda:
+    needs: deploy
+    runs-on: ubuntu-latest
+    environment: build_and_publish
+    permissions:
+      contents: read
+    defaults:
+      run:
+        shell: bash -l {0}
+    steps:
+    # The tag, not the commit the workflow was dispatched on, which predates the version bump.
+    - uses: actions/checkout@v4
+      with:
+        ref: v${{ github.event.inputs.version }}
+    # Runner images no longer all ship conda (Ubuntu 26.04 does not), so set it up as CI-test.yml does.
