+
+def _reported_graph(reverse_middle):
+    graph = Graph()
+    middle = ("D", "F") if reverse_middle else ("F", "D")
+    for source, target in [("A", "B"), ("A", "C"), ("B", "D"), ("C", "E"), ("E", "F"), middle, ("F", "G")]:
+        graph.add_edge(source, target, type=EdgeType.UNDIRECTED, weight=1)
+    return graph
