+
+
+def test_multisample_shortest_path_accepts_one_condition(backend):
+    graph = _weighted_graph(EdgeType.DIRECTED, False)
+    problem, flow_graph = create_multisample_shortest_path(graph, [("A", "D")], backend=backend)
+    problem.solve()
