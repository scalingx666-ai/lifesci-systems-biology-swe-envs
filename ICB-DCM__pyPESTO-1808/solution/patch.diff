diff --git a/.github/actions/setup-tox/action.yml b/.github/actions/setup-tox/action.yml
index de2ee539e..539f7db41 100644
--- a/.github/actions/setup-tox/action.yml
+++ b/.github/actions/setup-tox/action.yml
@@ -19,6 +19,13 @@ runs:
       shell: bash
       run: echo "week=$(date -u +%G-W%V)" >> "$GITHUB_OUTPUT"
 
+    # runner image (e.g. ubuntu24, ubuntu26): wheels built from source link
+    # against system libraries, so caches must not cross image versions
+    - name: Get runner image
+      id: image
+      shell: bash
+      run: echo "image=${ImageOS:-unknown}" >> "$GITHUB_OUTPUT"
+
     # download caches never decide which versions get installed,
     # so falling back to older entries is safe
     - name: Cache downloads
@@ -27,10 +34,10 @@ runs:
         path: |
           ~/.cache/pip
           ~/.cache/uv
-        key: "${{ runner.os }}-${{ runner.arch }}-py${{ steps.setup-python.outputs.python-version }}-dl-${{ github.job }}-${{ steps.week.outputs.week }}"
+        key: "${{ runner.os }}-${{ steps.image.outputs.image }}-${{ runner.arch }}-py${{ steps.setup-python.outputs.python-version }}-dl-${{ github.job }}-${{ steps.week.outputs.week }}"
         restore-keys: |
-          ${{ runner.os }}-${{ runner.arch }}-py${{ steps.setup-python.outputs.python-version }}-dl-${{ github.job }}-
-          ${{ runner.os }}-${{ runner.arch }}-py${{ steps.setup-python.outputs.python-version }}-dl-
+          ${{ runner.os }}-${{ steps.image.outputs.image }}-${{ runner.arch }}-py${{ steps.setup-python.outputs.python-version }}-dl-${{ github.job }}-
+          ${{ runner.os }}-${{ steps.image.outputs.image }}-${{ runner.arch }}-py${{ steps.setup-python.outputs.python-version }}-dl-
 
     # no restore-keys: restoring an older env would bring back stale
     # dependencies
@@ -38,4 +45,4 @@ runs:
       uses: actions/cache@v6
       with:
         path: .tox/
-        key: "${{ runner.os }}-${{ runner.arch }}-py${{ steps.setup-python.outputs.python-version }}-tox-${{ github.job }}-${{ hashFiles('tox.ini', 'pyproject.toml') }}-${{ steps.week.outputs.week }}"
